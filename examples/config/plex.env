# ─────────────────────────────────────────────────────────────────────────────
# PROFILE 3: Plex library.
#
# For: "I want these to show up correctly in Plex with covers and series order."
#
# Plex setup this config assumes (see docs/plex.md):
#   Library type : Music
#   Agent        : Audnexus
#   Layout       : Author/Series/Book N - Title/
#
# The tag set written here follows seanap's Plex-Audiobook-Guide, which is
# what makes series sort correctly instead of alphabetically.
# ─────────────────────────────────────────────────────────────────────────────

PIPELINE_LEVEL=normal

WORK_DIR="./work"
LOG_DIR="./logs"

# Point this at the same directory your Plex audiobook library scans.
NFS_OUTPUT_DIR="/path/to/plex/audiobooks"

# Plex must be able to read these. Match the user Plex runs as.
FILE_OWNER=""
FILE_MODE="644"
DIR_MODE="755"

MAX_BITRATE=128
CHANNELS=1

# Audnexus supplies chapter tables and rich metadata by ASIN. Caching keeps
# repeat runs off the network; the API is free and community-run, so being a
# polite client matters.
METADATA_SOURCE=audnexus
AUDNEXUS_REGION=us
AUDNEXUS_CACHE_DIR="./cache/audnexus"
AUDNEXUS_CACHE_DAYS=30

# Optional. Everything above works without it.
PIPELINE_LLM_BASE_URL=""
