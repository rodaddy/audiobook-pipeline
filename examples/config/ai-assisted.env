# ─────────────────────────────────────────────────────────────────────────────
# PROFILE: AI-assisted. Full automation, messiest sources.
#
# For: "I have hundreds of badly-named files and I don't want to babysit it."
#
# What AI actually does here -- and what it does NOT:
#   DOES     decide between Audible candidates when fuzzy scoring is ambiguous
#            ("Forsworn" by two different authors -- which one is this?)
#   DOES     reconcile a folder name, an embedded tag, and a search result
#            that disagree about the title
#   DOES NOT touch your audio. Ever. No AI is involved in encoding.
#   DOES NOT invent metadata -- it picks between candidates it was given.
#
# Everything works WITHOUT this. AI raises the hit rate on messy input; it is
# not required for correct output. Start with simple-no-ai.env and come here
# only if you are hand-correcting too many books.
#
# ── Which endpoint? Any OpenAI-compatible one ────────────────────────────────
# Local and free (no data leaves your machine):
#   Ollama    PIPELINE_LLM_BASE_URL="http://localhost:11434/v1"
#             PIPELINE_LLM_MODEL="llama3.1"
#             PIPELINE_LLM_API_KEY="ollama"        (any non-empty string)
#   LM Studio PIPELINE_LLM_BASE_URL="http://localhost:1234/v1"
#
# Hosted:
#   OpenAI    PIPELINE_LLM_BASE_URL="https://api.openai.com/v1"
#             PIPELINE_LLM_MODEL="gpt-4o-mini"
#   Anthropic via a proxy, or any LiteLLM gateway you already run.
#
# NOTE THE VARIABLE NAMES. This project uses PIPELINE_LLM_* deliberately, NOT
# OPENAI_API_KEY, so it cannot pick up -- or be confused with -- a global key
# you have set for something else.
# ─────────────────────────────────────────────────────────────────────────────

PIPELINE_LEVEL=ai

WORK_DIR="./data/work"
LOG_DIR="./data/logs"
NFS_OUTPUT_DIR="./data/library"

MAX_BITRATE=128
CHANNELS=1

PIPELINE_LLM_BASE_URL="http://localhost:11434/v1"
PIPELINE_LLM_API_KEY="ollama"
PIPELINE_LLM_MODEL="llama3.1"

# Ask the model about every book, not only ambiguous ones. Slower and more
# tokens; useful for a big messy first import, wasteful for tidy sources.
AI_ALL=false

# Below this fuzzy score, the pipeline asks the model instead of guessing.
# Lower = more AI calls. 65 is a reasonable middle.
ASIN_SEARCH_THRESHOLD=65

METADATA_SOURCE=audnexus
AUDNEXUS_REGION=us
AUDNEXUS_CACHE_DIR="./data/cache/audnexus"
AUDNEXUS_CACHE_DAYS=30
