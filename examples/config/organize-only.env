# ─────────────────────────────────────────────────────────────────────────────
# PROFILE 2: Organize only. Do not re-encode anything.
#
# For: "My M4Bs are fine. My FOLDERS are a disaster."
#
# What you get:
#   - Existing M4B files identified, tagged, and filed as Author/Series/Title
#   - Audio is NEVER re-encoded -- files are copied, not transcoded
#   - Works on a pile of loose M4Bs with meaningless names
#
# Run it with --mode organize (or --reorganize to MOVE files already in your
# library rather than copy new ones in). Always --dry-run first.
# ─────────────────────────────────────────────────────────────────────────────

PIPELINE_LEVEL=normal

WORK_DIR="./work"
LOG_DIR="./logs"

# WHERE YOUR LIBRARY LIVES. This is the one line everyone must change.
# Books are filed under here as: Author/Series/Book N - Title/Book N - Title.m4b
NFS_OUTPUT_DIR="/path/to/your/audiobook/library"

# Match your media server's user so it can read what lands there.
# Find yours with `id -u` and `id -g`. Leave empty to inherit yours.
FILE_OWNER=""
FILE_MODE="644"
DIR_MODE="755"

# No AI needed to sort folders.
PIPELINE_LLM_BASE_URL=""

METADATA_SOURCE=audible
AUDIBLE_REGION=com
