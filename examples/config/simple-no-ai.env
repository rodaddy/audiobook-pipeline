# ─────────────────────────────────────────────────────────────────────────────
# PROFILE 1: Simple. No AI, no API keys, no network beyond Audible lookups.
#
# For: "I have a folder of MP3s and I want one chaptered M4B out of it."
#
# What you get:
#   - MP3/FLAC/M4A joined into a single M4B
#   - Chapters preserved if the source has them, otherwise one per file
#   - Standard tags written
#   - Output stays NEXT TO YOUR SOURCE. Nothing is moved into a library.
#
# What you do NOT need: an LLM, an API key, or a media server.
# ─────────────────────────────────────────────────────────────────────────────

PIPELINE_LEVEL=simple

# Where work happens. Needs free space roughly equal to the book's size.
# Anywhere you can write is fine -- this is scratch, cleaned up after.
WORK_DIR="./work"
LOG_DIR="./logs"

# Encoding. 128k mono is the speech default; the source bitrate is matched up
# to this cap, so a 64k source stays 64k rather than being inflated.
MAX_BITRATE=128
CHANNELS=1

# NO AI. Leaving PIPELINE_LLM_BASE_URL empty disables every LLM code path.
# This is the default -- it is stated explicitly here so it is obvious.
PIPELINE_LLM_BASE_URL=""
PIPELINE_LLM_API_KEY=""

# Metadata still works without AI: titles and authors come from the folder
# layout, embedded tags, and an Audible catalog search.
METADATA_SOURCE=audible
AUDIBLE_REGION=com
