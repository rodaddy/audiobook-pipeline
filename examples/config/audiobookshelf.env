# ─────────────────────────────────────────────────────────────────────────────
# PROFILE 4: Audiobookshelf (or Prologue, Booksonic, Jellyfin).
#
# For: "I run Audiobookshelf and want files it can match automatically."
#
# The key difference from the Plex profile is the ASIN. Audiobookshelf and
# Prologue read the `xid` MP4 atom (written as "ASIN:B0XXXXXXXX") and use it to
# pull a chapter table for a file that carries none. ffmpeg silently DROPS that
# atom, so the pipeline writes it with mp4tags instead.
#
#   Install mp4tags:  brew install mp4v2       (macOS)
#                     apt install mp4v2-utils  (Debian/Ubuntu)
#
# Without it the audio and standard tags are still correct -- you just lose
# ASIN-based matching and have to match manually in the UI.
# ─────────────────────────────────────────────────────────────────────────────

PIPELINE_LEVEL=normal

WORK_DIR="./data/work"
LOG_DIR="./data/logs"

# Audiobookshelf is happy with Author/Series/Title, the same layout as Plex.
NFS_OUTPUT_DIR="/path/to/audiobookshelf/audiobooks"

FILE_OWNER=""
FILE_MODE="644"
DIR_MODE="755"

MAX_BITRATE=128
CHANNELS=1

METADATA_SOURCE=audnexus
AUDNEXUS_REGION=us
AUDNEXUS_CACHE_DIR="./data/cache/audnexus"
AUDNEXUS_CACHE_DAYS=30

PIPELINE_LLM_BASE_URL=""
