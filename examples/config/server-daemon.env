# ─────────────────────────────────────────────────────────────────────────────
# PROFILE: Server / daemon install with a watch folder.
#
# For: "This runs unattended on my NAS or home server."
#
# THE ONLY PROFILE THAT USES SYSTEM PATHS. Everything else stays inside the
# project directory on purpose. Use this one when you have deliberately
# installed the pipeline as a service and created these directories with the
# right ownership:
#
#   sudo mkdir -p /var/lib/audiobook-pipeline /var/log/audiobook-pipeline
#   sudo chown -R youruser:youruser /var/lib/audiobook-pipeline \
#                                    /var/log/audiobook-pipeline
#
# Drop a book folder into INCOMING_DIR and the watcher picks it up once the
# files stop changing (STABILITY_THRESHOLD seconds), so a half-finished
# download is never converted.
# ─────────────────────────────────────────────────────────────────────────────

PIPELINE_LEVEL=normal

WORK_DIR="/var/lib/audiobook-pipeline/work"
OUTPUT_DIR="/var/lib/audiobook-pipeline/output"
LOG_DIR="/var/log/audiobook-pipeline"
ARCHIVE_DIR="/var/lib/audiobook-pipeline/archive"
LOCK_DIR="/var/lib/audiobook-pipeline/locks"

# Your real library. The media server reads this.
NFS_OUTPUT_DIR="/mnt/media/AudioBooks"

# Watch-folder pipeline.
INCOMING_DIR="/mnt/media/AudioBooks/_incoming"
QUEUE_DIR="/var/lib/audiobook-pipeline/queue"
PROCESSING_DIR="/var/lib/audiobook-pipeline/processing"
COMPLETED_DIR="/var/lib/audiobook-pipeline/completed"
FAILED_DIR="/var/lib/audiobook-pipeline/failed"

# Seconds a file must stay unchanged before it is considered fully written.
STABILITY_THRESHOLD=120

# Match the user your media server runs as, or it cannot read the output.
FILE_OWNER="1000:1000"
FILE_MODE="644"
DIR_MODE="755"

# Unattended runs should not saturate the box.
MAX_PARALLEL_CONVERTS=2
CPU_CEILING=70

MAX_BITRATE=128
CHANNELS=1

METADATA_SOURCE=audnexus
AUDNEXUS_CACHE_DIR="/var/lib/audiobook-pipeline/cache/audnexus"
AUDNEXUS_CACHE_DAYS=30

ARCHIVE_RETENTION_DAYS=90
LOG_LEVEL=INFO
