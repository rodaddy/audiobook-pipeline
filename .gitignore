# Runtime directories
work/
output/
processing/
queue/
completed/
failed/
locks/
logs/
archive/
manifests/

# Personal config (use .env.example as template)
.env

# Database (contains book metadata, cover art, author aliases)
*.db
*.db-wal
*.db-shm

# macOS
.DS_Store

# Python
python/.venv/
__pycache__/
*.pyc

# IDE
.vscode/
.idea/

# OMC / PRD session artifacts
.omc/
.prd/

# qmd project-local search index: the database is rebuildable
# and never committed; the allowlist config is tracked.
.qmd/*
!.qmd/index.yml

# Runtime state. Every path default lives under data/ so a fresh clone is
# self-contained -- which also means a first run would otherwise stage work
# files, the SQLite db, logs, and converted AUDIO for commit.
data/

# Backups written by scripts/setup/setup.sh before it overwrites .env
.env.backup.*

# Generated by _githooks/install.sh -- the SOURCE hooks are tracked, the
# installed chain wrappers are machine-specific and are not.
_githooks/installed/
