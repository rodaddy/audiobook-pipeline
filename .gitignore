# Runtime directories
work/
output/
processing/
queue/
completed/
failed/
locks/
logs/
archive/
manifests/

# Personal config (use .env.example as template)
.env

# Database (contains book metadata, cover art, author aliases)
*.db
*.db-wal
*.db-shm

# macOS
.DS_Store

# Python
python/.venv/
/.venv/
/.venv-*/
__pycache__/
*.pyc

# IDE
.vscode/
.idea/

# OMC / PRD session artifacts
.omc/
.prd/

# qmd project-local search index. Entirely machine-local: it is a rebuildable
# artifact of one checkout, it goes stale the moment anything changes, and the
# index alone was 15 MB -- bloat every clone pays for and nobody reads.
.qmd/

# Agent and session working artifacts. Notes, dry-run logs, and review
# scratch from building this; useful while working, noise in a public repo.
.reports/
.omc/
_reports/

# Runtime state. Every path default lives under data/ so a fresh clone is
# self-contained -- which also means a first run would otherwise stage work
# files, the SQLite db, logs, and converted AUDIO for commit.
data/

# Backups written by scripts/setup/setup.sh before it overwrites .env
.env.backup.*

# Generated by _githooks/install.sh -- the SOURCE hooks are tracked, the
# installed chain wrappers are machine-specific and are not.
_githooks/installed/

# Machine-specific profiles. Only config.json and config.sandbox.json are
# tracked, and both hold PLACEHOLDER paths -- a committed profile is an
# example every reader copies, so a real one leaks the author's directory
# layout and is wrong on every other machine. Name yours anything else.
config/config.*.json
!config/config.sandbox.json

# Secrets: allowlist, not blocklist. Only the example and the README are
# tracked; a real config.json in here must never be committable.
secrets/*
!secrets/.gitkeep
!secrets/*.example.json
!secrets/README.md
